<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password — Protein Pricer</title>
  <meta name="description" content="Reset your Protein Pricer password.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

  <style>
    :root {
      --white: #fafafa;
      --gray-300: #a3a3a3;
      --gray-500: #737373;
      --black: #0a0a0a;
      --green: #10b981;
      --green-soft: rgba(16, 185, 129, 0.1);
      --red: #ef4444;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'DM Sans', -apple-system, sans-serif;
      background: var(--black);
      color: var(--white);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
    }

    .card {
      max-width: 440px;
      width: 100%;
      padding: 3rem 2.5rem;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.02);
    }

    .icon {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: var(--green-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      font-size: 1.75rem;
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    }

    h1 {
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
      animation: fadeUp 0.6s ease 0.15s both;
    }

    .message {
      color: var(--gray-300);
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      animation: fadeUp 0.6s ease 0.25s both;
    }

    .form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      animation: fadeUp 0.6s ease 0.35s both;
    }

    .input {
      width: 100%;
      padding: 0.875rem 1rem;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05);
      color: var(--white);
      font-size: 1rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s;
    }

    .input:focus {
      border-color: var(--green);
    }

    .input::placeholder {
      color: var(--gray-500);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.875rem 2rem;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      font-family: inherit;
      text-decoration: none;
      border: none;
      cursor: pointer;
      background: var(--green);
      color: var(--black);
      transition: transform 0.15s, opacity 0.15s;
      margin-top: 0.5rem;
    }

    .btn:hover { opacity: 0.9; }
    .btn:active { transform: scale(0.97); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .error {
      color: var(--red);
      font-size: 0.875rem;
      margin-top: 0.5rem;
      display: none;
    }

    .subtext {
      margin-top: 1.5rem;
      font-size: 0.8125rem;
      color: var(--gray-500);
      animation: fadeUp 0.6s ease 0.45s both;
    }

    .logo {
      position: fixed;
      top: 1.25rem;
      left: 2rem;
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--white);
      text-decoration: none;
    }

    .logo span { color: var(--green); }

    .hidden { display: none; }

    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.5); }
      to { opacity: 1; transform: scale(1); }
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 480px) {
      .card { padding: 2.5rem 1.5rem; }
    }
  </style>
</head>
<body>

  <a href="/" class="logo">Protein<span>Pricer</span></a>

  <!-- Reset form -->
  <div class="card" id="reset-form">
    <div class="icon">🔒</div>
    <h1>Reset your password</h1>
    <p class="message">Enter your new password below.</p>
    <div class="form">
      <input type="password" class="input" id="password" placeholder="New password" minlength="6">
      <input type="password" class="input" id="confirm-password" placeholder="Confirm password" minlength="6">
      <p class="error" id="error-msg"></p>
      <button class="btn" id="submit-btn" onclick="handleReset()">Update Password</button>
    </div>
  </div>

  <!-- Success state -->
  <div class="card hidden" id="success-card">
    <div class="icon">✓</div>
    <h1>Password updated!</h1>
    <p class="message">Your password has been changed. You can close this page and sign in with your new password in the app.</p>
    <a href="/" class="btn">Back to proteinpricer.com</a>
  </div>

  <!-- Error state (invalid/expired link) -->
  <div class="card hidden" id="error-card">
    <div class="icon">✕</div>
    <h1>Invalid or expired link</h1>
    <p class="message">This password reset link is no longer valid. Please request a new one from the app.</p>
    <a href="/" class="btn">Back to proteinpricer.com</a>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
  <script>
    var SUPABASE_URL = 'https://ribuwiakhfwythnxobdf.supabase.co';
    var SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJpYnV3aWFraGZ3eXRobnhvYmRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDE3MTM5MTQsImV4cCI6MjA1NzI4OTkxNH0.G5MRFMBv2MduUBXqLWkMKsgsfX_RNdbSjgMQVwnmkIA';

    var client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // Check for valid recovery session on page load
    (async function init() {
      var hash = window.location.hash;
      if (!hash || !hash.includes('type=recovery')) {
        showError();
        return;
      }

      // Let Supabase client pick up the session from the URL
      var result = await client.auth.getSession();
      if (result.error || !result.data.session) {
        showError();
      }
    })();

    async function handleReset() {
      var password = document.getElementById('password').value;
      var confirm = document.getElementById('confirm-password').value;
      var errorMsg = document.getElementById('error-msg');
      var btn = document.getElementById('submit-btn');

      errorMsg.style.display = 'none';

      if (password.length < 6) {
        errorMsg.textContent = 'Password must be at least 6 characters.';
        errorMsg.style.display = 'block';
        return;
      }

      if (password !== confirm) {
        errorMsg.textContent = 'Passwords do not match.';
        errorMsg.style.display = 'block';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Updating...';

      var result = await client.auth.updateUser({ password: password });

      if (result.error) {
        errorMsg.textContent = result.error.message;
        errorMsg.style.display = 'block';
        btn.disabled = false;
        btn.textContent = 'Update Password';
        return;
      }

      showSuccess();
    }

    function showError() {
      document.getElementById('reset-form').classList.add('hidden');
      document.getElementById('error-card').classList.remove('hidden');
    }

    function showSuccess() {
      document.getElementById('reset-form').classList.add('hidden');
      document.getElementById('success-card').classList.remove('hidden');
    }
  </script>

</body>
</html>
